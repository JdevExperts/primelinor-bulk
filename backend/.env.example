# ─────────────────────────────────────────────────────────────
#  PrimeLinor Backend — environment template
#  Copy to .env and fill in real values. Never commit .env itself.
#
#  This backend requires its OWN new PostgreSQL database.
#  It must not point at the old primelinor-bulk production database.
# ─────────────────────────────────────────────────────────────

# Same default the previous primelinor-bulk backend used (its server.js
# fallback was also `process.env.PORT || 4001`) — kept aligned so any
# existing Nginx upstream / process-manager config pointing at 4001 needs
# no change. Override via the real env var per host if a platform assigns
# its own port.
PORT=4001

# New database only — see prisma/schema.prisma. Example for local dev:
# DATABASE_URL="postgresql://YOUR_USER@localhost:5432/primelinor_dev"
DATABASE_URL=

# Comma-separated list of allowed frontend origins
#
# Confirmed production value: FRONTEND_ORIGIN=https://primelinorbulk.com
FRONTEND_ORIGIN=http://localhost:5173

# Set to 1 when running behind a reverse proxy (Nginx/ALB) so req.ip is correct
TRUST_PROXY=0

# ── S3 (real artwork storage) ───────────────────────────────────────────────
# Leave AWS_S3_BUCKET/AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY unset in dev —
# artwork uploads then fall back to local disk storage automatically
# (src/services/storage/index.js). Set all three to switch to real S3.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BASE_URL=

# ── Local artwork storage (dev fallback only) ───────────────────────────────
# HMAC secret signing the dev-only artwork preview links (§ storage/localStorage.js).
# Set a real random value outside local dev.
ARTWORK_URL_SECRET=dev-only-insecure-artwork-secret
# Base URL this backend is reachable at — used to build local preview links.
BACKEND_PUBLIC_URL=http://localhost:4001

# ── Staff auth (Phase 3) ─────────────────────────────────────────────────────
# Signs the admin session JWT (services/auth.js). Required — the server
# refuses to start without it outside NODE_ENV=test. Generate a real random
# value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Set to "production" to mark the admin cookie Secure (HTTPS-only).
NODE_ENV=development

# ── Customer quote delivery (Phase 4) ───────────────────────────────────────
# The canonical customer-facing frontend origin — used to build the
# /quote/:token links returned when a quotation is sent, and to derive the
# website URL shown on quotation PDFs. Distinct from FRONTEND_ORIGIN (a
# CORS allowlist that may list several dev ports).
#
# Confirmed production value (Phase 6B owner-input closure):
#   PUBLIC_APP_URL=https://primelinorbulk.com
# Left as the local-dev default below — set the real value above only in
# the actual production environment's config, never commit it here.
PUBLIC_APP_URL=http://localhost:5187

# WhatsApp click-to-chat handoff (no WhatsApp Business API). Digits only,
# with country code, e.g. 919812345678. Leave blank to disable the
# "Continue on WhatsApp" action everywhere — GET /api/v1/config/public
# reports whatsappEnabled:false and the frontend hides the button rather
# than showing a fake/dead action.
#
# Confirmed production value: WHATSAPP_NUMBER=919599122214
WHATSAPP_NUMBER=
# Optional — shown as a real contact channel only if set.
# Confirmed production value: SUPPORT_EMAIL=primelinor@gmail.com
SUPPORT_EMAIL=

# ── Dev seed guard (Production Hardening Patch) ─────────────────────────────
# prisma/seed.js refuses to run when NODE_ENV=production (it deletes/recreates
# its 5 demo products by slug on every run). Leave unset in dev/staging — the
# guard only fires when NODE_ENV=production. Set to "true" only for a genuine
# one-off need to seed a fresh production DB before real products exist.
ALLOW_DEV_SEED=

# DEV / MAINTENANCE ONLY — never set in the long-running production
# environment. prisma/createStaffUser.js (the only way to create a StaffUser)
# refuses to run when NODE_ENV=production unless this is "true" for that one
# invocation — see DEPLOYMENT.md §4c. Set it only on the command line for the
# single bootstrap command, never as a persisted var in the process manager /
# hosting dashboard.
ALLOW_ADMIN_BOOTSTRAP=
