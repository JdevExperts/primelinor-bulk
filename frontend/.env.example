# Copy to .env.local (gitignored by Vite's default template) and adjust as needed.

# Base URL of the backend API (see /backend). Defaults to the local
# dev backend if unset. This is a BUILD-TIME value baked into the bundle by
# `vite build` — set it in the production build environment before running
# the build, never after.
#
# Confirmed production value: VITE_API_BASE_URL=https://api.primelinorbulk.com/api/v1
# NOTE: the API lives on its own subdomain (api.primelinorbulk.com), NOT a
# /api/v1 path under primelinorbulk.com — the production Nginx config has
# no /api/ location block on the main domain, so pointing this at
# https://primelinorbulk.com/api/v1 builds a working-looking bundle that
# silently gets index.html back for every API call instead of JSON. This
# exact mistake happened once during the production cutover.
VITE_API_BASE_URL=http://localhost:4001/api/v1

# Dev-only, explicit opt-in: serve the local mock catalogue instead of
# calling the real API, for frontend-only work with no backend running.
# Never used in production builds regardless of this value.
VITE_USE_MOCK_CATALOG=false
